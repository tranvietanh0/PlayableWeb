{
  "name": "playable-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/@pwe/*",
    "apps/*",
    "services/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "pnpm --filter './packages/**' build",
    "test": "pnpm --filter './packages/**' test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter './packages/**' typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.12.0"
  },
  "packageManager": "pnpm@9.0.0"
}
